# Copy to .env and fill in your own Supabase project. Never commit .env.
# Only the project URL and the anon (publishable) key belong in the client.
# This app does not use the service-role key.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional preview. Set to sample to load lib/sample-items.ts and skip Supabase.
# Leave this unset when the app should read a real library, including when you publish.
# EXPO_PUBLIC_DEMO=
